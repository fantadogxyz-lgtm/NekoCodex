    <property name="styleSheet">
     <string notr="true">/* Общий стиль для поля даты */
QDateEdit {
    padding-right: 24px; /* Освобождаем место справа, чтобы клики не перекрывались */
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    selection-background-color: rgb(111, 111, 166);
    color: #333333;
}

/* Кнопка &quot;Вверх&quot; (в верхнем правом углу) */
QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right; 
    width: 22px;
    height: 14px; 
    border-left: 1px solid #cccccc;
    border-bottom: 1px solid #cccccc;
    background: #f5f5f5;
    border-top-right-radius: 4px;
}

/* Кнопка &quot;Вниз&quot; (в нижнем правом углу) */
QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    height: 14px;
    border-left: 1px solid #cccccc;
    background: #f5f5f5;
    border-bottom-right-radius: 4px;
}

/* Стили при наведении на кнопки */
QDateEdit::up-button:hover, QDateEdit::down-button:hover {
    background: #e0e0e0;
}

/* Стили при клике */
QDateEdit::up-button:pressed, QDateEdit::down-button:pressed {
    background: #cdcdcd;
}

/* --- Отрисовка стрелочек через CSS-границы (border-трюк) --- */

/* Стрелка ВВЕРХ */
QDateEdit::up-arrow {
    image: none; 
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: none;
    width: 0px;
    height: 0px;
}

/* Подсветка стрелки ВВЕРХ при наведении */
QDateEdit::up-arrow:hover {
    border-bottom-color: #000000;
}

/* Стрелка ВНИЗ */
QDateEdit::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top:  none; 
    width: 0px;
    height: 0px;
}

/* Подсветка стрелки ВНИЗ при наведении */
QDateEdit::down-arrow:hover {
    border-top-color: #000000;
}</string>
    </property>
   </widget>
