    <property name="styleSheet">
     <string notr="true">/* Общий стиль для SpinBox */QSpinBox {
    padding-right: 24px; /* Освобождаем место справа, чтобы текст и поле НЕ наслаивались на стрелочки */
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    selection-background-color: rgb(111, 111, 166);
    color: #333333;
}

/* Кнопка &quot;Вверх&quot; (располагаем в верхнем правом углу) */
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right; 
    width: 22px;
    height: 14px; /* Половина высоты с небольшим запасом */
    border-left: 1px solid #cccccc;
    border-bottom: 1px solid #cccccc;
    background: #f5f5f5;
    border-top-right-radius: 4px;
}

/* Кнопка &quot;Вниз&quot; (располагаем в нижнем правом углу) */
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    height: 14px;
    border-left: 1px solid #cccccc;
    background: #f5f5f5;
    border-bottom-right-radius: 4px;
}

/* Стили при наведении на кнопки */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #e0e0e0;
}

/* Стили при клике */
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background: #cdcdcd;
}

/* Отрисовка самих стрелочек внутри кнопок (рисуем встроенными стрелками Qt) */
QSpinBox::up-arrow {
    image: url(none); /* Если у тебя есть свои иконки, укажи путь тут */
    width: 7px;
    height: 7px;
}

QSpinBox::up-arrow {
    image: url(none); /* Отключаем поиск картинки */
    content: &quot;▲&quot;;     /* Вставляем текстовый треугольник вверх */
    font-size: 9px;   /* Подбираем размер стрелочки */
    color: rgb(31, 31, 31);   /* Цвет стрелочки */
}

QSpinBox::down-arrow {
    image: url(none); /* Отключаем поиск картинки */
    content: &quot;▼&quot;;     /* Вставляем текстовый треугольник вниз */
    font-size: 9px;   /* Подбираем размер стрелочки */
    color: rgb(31, 31, 31);   /* Цвет стрелочки */
}

/* Цвет стрелочек при наведении на весь SpinBox (опционально) */
QSpinBox::up-arrow:hover, QSpinBox::down-arrow:hover {
    color: #000000;
}


